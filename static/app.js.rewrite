/* GLG single-file web app: drives the full local compile engine.
   Questions come from GLG_DATA.questions (310) + synthesized base questions.
   Answers are bridged to compiler keys by GLGMap. */

(function () {
    'use strict';

    var GLG = window.GLG || {};
    var DATA = (typeof GLG_DATA !== 'undefined') ? GLG_DATA : null;
    var ENGINE = window.GLGEngine || null;
    var MAP = window.GLGMap || null;

    /* ── Steps: category -> step ─────────────────────────────────────────── */
    var CATEGORY_STEP = {
        Ownership: 'ownership', Copyright: 'copyright', Notice: 'copyright',
        Attribution: 'copyright', Trademark: 'copyright',
        CommercialUse: 'commercial', DualLicensing: 'commercial', Royalty: 'commercial',
        Subscription: 'commercial', PerSeat: 'commercial', PerUser: 'commercial',
        PerDevice: 'commercial', PerCpu: 'commercial', PerCompany: 'commercial',
        OpenCore: 'commercial', EnterpriseFeatures: 'commercial', FeatureFlags: 'commercial',
        CommercialExceptions: 'commercial', Resale: 'commercial', Oem: 'commercial',
        PatentGrant: 'patent', PatentRetaliation: 'patent',
        SourceDisclosure: 'source', StaticLinking: 'source', DynamicLinking: 'source',
        Distribution: 'distribution', NetworkUse: 'distribution', Redistribution: 'distribution',
        Hosting: 'distribution', Cloud: 'distribution', Saas: 'distribution',
        Paas: 'distribution', Containers: 'distribution',
        Modification: 'modification', DerivativeWorks: 'modification', Forks: 'modification',
        Contributions: 'modification', PullRequests: 'modification',
        ContributorLicenseAgreement: 'modification',
        AiTraining: 'aidata', AiInference: 'aidata', ModelWeights: 'aidata', DatasetUsage: 'aidata',
        Telemetry: 'aidata', Watermarking: 'aidata', Privacy: 'aidata',
        Jurisdiction: 'compliance', ExportControl: 'compliance', Cryptography: 'compliance',
        Drm: 'compliance', Government: 'compliance', Military: 'compliance',
        GovernmentUse: 'compliance', Defense: 'compliance', Healthcare: 'compliance',
        Finance: 'compliance', Biotechnology: 'compliance', Nuclear: 'compliance', Children: 'compliance',
        Warranty: 'special', Liability: 'special', Termination: 'special', Revocation: 'special',
        Expiration: 'special', PrivateUse: 'special', Research: 'special', Academic: 'special',
        Education: 'special', ResearchInstitutions: 'special', Nonprofit: 'special',
        Foundation: 'special', Robotics: 'special', Iot: 'special', Embedded: 'special',
        SpecialPermissions: 'special'
    };

    var STEPS = [
        { id: 'intro',       label: 'Introduction',      icon: '01' },
        { id: 'ownership',   label: 'Ownership',         icon: '02' },
        { id: 'copyright',   label: 'Copyright',         icon: '03' },
        { id: 'commercial',  label: 'Commercial Use',    icon: '04' },
        { id: 'patent',      label: 'Patent',            icon: '05' },
        { id: 'source',      label: 'Source Code',       icon: '06' },
        { id: 'distribution',label: 'Distribution',      icon: '07' },
        { id: 'modification',label: 'Modification',      icon: '08' },
        { id: 'aidata',      label: 'AI & Data',         icon: '09' },
        { id: 'compliance',  label: 'Compliance',        icon: '10' },
        { id: 'special',     label: 'Special Terms',     icon: '11' },
        { id: 'review',      label: 'Review',            icon: '12' },
        { id: 'export',      label: 'Export',            icon: '13' }
    ];

    /* ── Synthesized base questions (feed the compiler directly) ─────────── */
    var LICENSE_TYPE_OPTS = [
        { label: 'Permissive (MIT-style)', value: 'permissive', description: 'Minimal restrictions, broad permissions' },
        { label: 'Copyleft (GPL-style)',   value: 'copyleft',   description: 'Derivative works must stay open' },
        { label: 'Public domain',          value: 'public_domain', description: 'Dedicate to the public domain' },
        { label: 'BSD',                    value: 'bsd',        description: 'BSD family (2/3/4-clause)' },
        { label: 'Apache 2.0',             value: 'apache',     description: 'Apache with patent grant' },
        { label: 'ISC',                    value: 'isc',        description: 'Simple permissive ISC license' },
        { label: 'MPL 2.0',                value: 'mpl',        description: 'File-level weak copyleft' },
        { label: 'LGPL',                   value: 'lgpl',       description: 'Weak copyleft for libraries' },
        { label: 'Network copyleft (AGPL)', value: 'network_copyleft', description: 'Copyleft over the network' },
        { label: 'Proprietary',            value: 'proprietary',description: 'All rights reserved' },
        { label: 'Commercial',             value: 'commercial', description: 'Paid commercial license' }
    ];

    var SYNTIETIC = [
        { id: 'project_name', step: 'intro', title: 'Project Name', description: 'What is the name of your project?', placeholder: 'e.g., MyAwesomeProject', question_type: 'Text', required: true, synth: true },
        { id: 'copyright_holder', step: 'intro', title: 'Copyright Holder', description: 'Legal name of the copyright holder (person or entity).', placeholder: 'e.g., Jane Doe or Acme Corp', question_type: 'Text', required: true, synth: true },
        { id: 'copyright_email', step: 'intro', title: 'Copyright Holder Email', description: 'Contact email for the copyright holder (used for commercial license inquiries).', placeholder: 'optional', question_type: 'Text', required: false, synth: true },
        { id: 'copyright_org', step: 'intro', title: 'Organization', description: 'Organization name, if the holder is a company.', placeholder: 'optional', question_type: 'Text', required: false, synth: true },
        { id: 'license_type', step: 'intro', title: 'Base License Model', description: 'Choose the starting license family. Additional questions fine-tune it.', question_type: 'Choice', options: LICENSE_TYPE_OPTS, required: true, synth: true },
        { id: 'bsd_variant', step: 'intro', title: 'BSD Variant', description: 'Which BSD variant should be used as the base?', question_type: 'Choice', options: [
            { label: 'BSD-2-Clause', value: 'bsd-2', description: 'Simplified BSD (recommended)' },
            { label: 'BSD-3-Clause', value: 'bsd-3', description: 'BSD with advertising clause' },
            { label: 'BSD-4-Clause', value: 'bsd-4', description: 'BSD with advertising + endorsement' }
        ], required: false, synth: true, visible_if: { question_id: 'license_type', operator: 'Equals', value: 'bsd' } },
        { id: 'gpl_version', step: 'intro', title: 'GPL Version', description: 'Which GPL version?', question_type: 'Choice', options: [
            { label: 'GPL-3.0-or-later', value: '3.0-or-later', description: 'Recommended' },
            { label: 'GPL-3.0-only', value: '3.0-only' },
            { label: 'GPL-2.0-or-later', value: '2.0-or-later' },
            { label: 'GPL-2.0-only', value: '2.0-only' }
        ], required: false, synth: true, visible_if: { question_id: 'license_type', operator: 'Equals', value: 'copyleft' } },
        { id: 'lgpl_version', step: 'intro', title: 'LGPL Version', description: 'Which LGPL version?', question_type: 'Choice', options: [
            { label: 'LGPL-3.0-or-later', value: '3.0-or-later', description: 'Recommended' },
            { label: 'LGPL-3.0-only', value: '3.0-only' },
            { label: 'LGPL-2.1-or-later', value: '2.1-or-later' },
            { label: 'LGPL-2.1-only', value: '2.1-only' }
        ], required: false, synth: true, visible_if: { question_id: 'license_type', operator: 'Equals', value: 'lgpl' } },
        { id: 'agpl_version', step: 'intro', title: 'AGPL Version', description: 'Which AGPL version?', question_type: 'Choice', options: [
            { label: 'AGPL-3.0-or-later', value: '3.0-or-later', description: 'Recommended' },
            { label: 'AGPL-3.0-only', value: '3.0-only' }
        ], required: false, synth: true, visible_if: { question_id: 'license_type', operator: 'Equals', value: 'network_copyleft' } },
        { id: 'public_domain_variant', step: 'intro', title: 'Public Domain Tool', description: 'Which public domain dedication?', question_type: 'Choice', options: [
            { label: 'Unlicense', value: 'unlicense', description: 'Recommended' },
            { label: 'CC0 1.0', value: 'cc0', description: 'Creative Commons Zero' }
        ], required: false, synth: true, visible_if: { question_id: 'license_type', operator: 'Equals', value: 'public_domain' } },
        { id: 'commercial_model', step: 'intro', title: 'Commercial Model', description: 'How is this software licensed commercially? (optional)', question_type: 'Choice', options: [
            { label: 'Subscription', value: 'subscription', description: 'Recurring subscription' },
            { label: 'Evaluation', value: 'evaluation', description: 'Time-limited evaluation' },
            { label: 'Open core', value: 'open_core', description: 'Free core + paid enterprise features' },
            { label: 'Per seat', value: 'per_seat', description: 'Per user seat' },
            { label: 'Per company', value: 'per_company', description: 'Company-wide license' },
            { label: 'OEM', value: 'oem', description: 'OEM bundling' },
            { label: 'None', value: '', description: 'No commercial model' }
        ], required: false, synth: true }
    ];

    /* ── UI wiring identical to the original shell ───────────────────────── */
    var state = {
        currentStep: 0,
        answers: {},
        questions: [],
        licenseText: '',
        licenseObj: null,
        generating: false
    };

    var $ = function (sel, ctx) { return (ctx || document).querySelector(sel); };
    var $$ = function (sel, ctx) { return Array.prototype.slice.call((ctx || document).querySelectorAll(sel)); };

    function saveProgress() {
        try {
            localStorage.setItem('glg_state', JSON.stringify({ currentStep: state.currentStep, answers: state.answers }));
        } catch (e) {}
    }
    function loadProgress() {
        try {
            var raw = localStorage.getItem('glg_state');
            if (raw) {
                var data = JSON.parse(raw);
                if (data && typeof data.answers === 'object') {
                    state.answers = data.answers;
                    if (typeof data.currentStep === 'number' && data.currentStep < STEPS.length) state.currentStep = data.currentStep;
                }
            }
        } catch (e) {}
    }

    function toast(message, type) {
        type = type || 'info';
        var container = $('#toast-container');
        var el = document.createElement('div');
        el.className = 'toast toast-' + type;
        var icons = {
            success: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
            warning: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
            error: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>',
            info: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>'
        };
        el.innerHTML = '<span class="toast-icon">' + (icons[type] || icons.info) + '</span>' +
            '<span class="toast-message">' + escapeHtml(message) + '</span>' +
            '<button class="toast-close" aria-label="Close"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';
        el.querySelector('.toast-close').addEventListener('click', function () { dismissToast(el); });
        container.appendChild(el);
        setTimeout(function () { dismissToast(el); }, 5000);
    }
    function dismissToast(el) {
        if (el.classList.contains('removing')) return;
        el.classList.add('removing');
        setTimeout(function () { el.remove(); }, 300);
    }
    function escapeHtml(str) {
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(str == null ? '' : String(str)));
        return d.innerHTML;
    }
    function showModal(title, bodyHtml, buttons) {
        $('#modal-title').textContent = title;
        $('#modal-body').innerHTML = bodyHtml;
        var footer = $('#modal-footer');
        footer.innerHTML = '';
        if (buttons && buttons.length) {
            buttons.forEach(function (b) {
                var btn = document.createElement('button');
                btn.className = 'btn ' + (b.cls || 'btn-secondary');
                btn.textContent = b.label;
                btn.addEventListener('click', function () { if (b.action) b.action(); hideModal(); });
                footer.appendChild(btn);
            });
        }
        $('#modal-overlay').classList.remove('hidden');
    }
    function hideModal() { $('#modal-overlay').classList.add('hidden'); }

    /* ── Question model ──────────────────────────────────────────────────── */
    function buildQuestions() {
        var list = [];
        SYNTIETIC.forEach(function (q) { list.push(q); });
        if (DATA && DATA.questions) {
            DATA.questions.forEach(function (q) {
                var step = CATEGORY_STEP[q.category] || 'special';
                list.push({
                    id: q.id, step: step, title: q.title, description: q.description,
                    tooltip: q.tooltip, help_text: q.help_text, legal_implications: q.legal_implications,
                    recommended_answer: q.recommended_answer, question_type: q.question_type,
                    options: q.options || [], visible_if: q.visible_if, weight: q.weight,
                    category: q.category, synth: false, required: false
                });
            });
        }
        return list;
    }

    function getQuestionsForStep(stepIdx) {
        var sid = STEPS[stepIdx].id;
        return state.questions.filter(function (q) { return q.step === sid; });
    }

    function visibleIfMet(q) {
        if (!q.visible_if) return true;
        var v = q.visible_if;
        var val = state.answers[v.question_id];
        var target;
        if (v.value && v.value.Boolean !== undefined) target = v.value.Boolean;
        else target = v.value && v.value.Choice !== undefined ? v.value.Choice : v.value;
        var matches;
        if (Array.isArray(val)) matches = val.indexOf(target) !== -1;
        else matches = val === target;
        if (v.operator === 'NotEquals') matches = !matches;
        return matches;
    }

    /* Prune answers for questions that are no longer visible. */
    function pruneHiddenAnswers() {
        state.questions.forEach(function (q) {
            if (!visibleIfMet(q)) delete state.answers[q.id];
        });
    }

    /* ── Rendering ───────────────────────────────────────────────────────── */
    function renderSidebar() {
        var list = $('#step-list');
        list.innerHTML = '';
        STEPS.forEach(function (step, i) {
            var li = document.createElement('li');
            li.className = 'step-item' + (i === state.currentStep ? ' active' : '') + (isStepCompleted(i) ? ' completed' : '');
            li.innerHTML = '<span class="step-number">' + (isStepCompleted(i) ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>' : step.icon) + '</span>' +
                '<span class="step-label">' + step.label + '</span>';
            li.addEventListener('click', function () { goToStep(i); });
            list.appendChild(li);
        });
    }

    function isStepCompleted(idx) {
        var qs = getQuestionsForStep(idx).filter(visibleIfMet);
        if (qs.length === 0) return true;
        return qs.every(function (q) {
            if (!q.required) return true;
            var val = state.answers[q.id];
            return val !== undefined && val !== null && val !== '' && !(Array.isArray(val) && val.length === 0);
        });
    }

    function updateProgress() {
        var completed = 0;
        for (var i = 0; i < STEPS.length; i++) if (isStepCompleted(i)) completed++;
        var pct = Math.round((completed / STEPS.length) * 100);
        $('#progress-pct').textContent = pct + '%';
        $('#progress-fill').style.width = pct + '%';
    }
    function updateStepIndicator() {
        var c = $('#step-indicator');
        c.innerHTML = '';
        STEPS.forEach(function (_, i) {
            var dot = document.createElement('div');
            dot.className = 'step-dot' + (i === state.currentStep ? ' active' : '') + (isStepCompleted(i) && i !== state.currentStep ? ' completed' : '');
            c.appendChild(dot);
        });
    }
    function updateButtons() {
        var prev = $('#btn-prev'), next = $('#btn-next'), gen = $('#btn-generate'), exp = $('#btn-export');
        prev.disabled = state.currentStep === 0;
        if (state.currentStep === STEPS.length - 1) {
            next.classList.add('hidden');
            gen.classList.remove('hidden');
        } else {
            next.classList.remove('hidden');
            gen.classList.add('hidden');
        }
        exp.disabled = !state.licenseText;
    }

    function renderWizardStep(stepIdx) {
        var container = $('#wizard-steps');
        container.innerHTML = '';
        var step = STEPS[stepIdx];
        var qs = getQuestionsForStep(stepIdx).filter(visibleIfMet);
        var stepDiv = document.createElement('div');
        stepDiv.className = 'wizard-step active';
        var header = document.createElement('div');
        header.className = 'step-header';
        header.innerHTML = '<h2>' + step.label + '</h2>';
        header.innerHTML += stepIdx === 0
            ? '<p>Welcome to the Granular License Generator. Start by naming your project and choosing a base license family. The remaining steps refine the compiled license (all done locally, fully offline).</p>'
            : '<p>Step ' + (stepIdx + 1) + ' of ' + STEPS.length + '</p>';
        stepDiv.appendChild(header);

        if (qs.length === 0 && stepIdx > 0 && stepIdx < STEPS.length - 2) {
            var empty = document.createElement('div');
            empty.className = 'question-card';
            empty.innerHTML = '<p class="text-muted text-sm">No questions for this step yet. Click Next to continue.</p>';
            stepDiv.appendChild(empty);
        }

        if (stepIdx === STEPS.length - 2) stepDiv.appendChild(renderReviewStep());
        if (stepIdx === STEPS.length - 1) stepDiv.appendChild(renderExportStep());

        var lastCat = null;
        qs.forEach(function (q) {
            if (q.category && q.category !== lastCat) {
                lastCat = q.category;
                var tag = document.createElement('div');
                tag.className = 'category-tag';
                tag.innerHTML = '<span class="category-label">' + escapeHtml(q.category) + '</span>';
                stepDiv.appendChild(tag);
            }
            stepDiv.appendChild(renderQuestion(q));
        });

        container.appendChild(stepDiv);
    }

    function renderQuestion(q) {
        var card = document.createElement('div');
        card.className = 'question-card';
        card.setAttribute('data-question-id', q.id);
        if (q.synth) card.classList.add('synth-question');

        var labelHtml = '<div class="question-label">';
        if (q.required) labelHtml += '<span class="required">*</span>';
        labelHtml += '<span>' + escapeHtml(q.title) + '</span></div>';
        card.innerHTML = labelHtml;

        if (q.description) {
            var desc = document.createElement('div');
            desc.className = 'question-description';
            desc.textContent = q.description;
            card.appendChild(desc);
        }

        var inputWrap = document.createElement('div');
        switch (q.question_type) {
            case 'Choice': inputWrap.appendChild(renderChoice(q)); break;
            case 'Boolean': inputWrap.appendChild(renderBoolean(q)); break;
            case 'MultiChoice': inputWrap.appendChild(renderMulti(q)); break;
            case 'Number': inputWrap.appendChild(renderNumber(q)); break;
            case 'Text':
            default: inputWrap.appendChild(renderText(q)); break;
        }
        card.appendChild(inputWrap);

        if (q.legal_implications) {
            var leg = document.createElement('div');
            leg.className = 'legal-note';
            leg.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg> ' + escapeHtml(q.legal_implications);
            card.appendChild(leg);
        }

        var errDiv = document.createElement('div');
        errDiv.className = 'question-error';
        errDiv.textContent = 'This field is required.';
        card.appendChild(errDiv);
        return card;
    }

    function renderChoice(q) {
        var group = document.createElement('div');
        group.className = 'radio-group';
        var current = state.answers[q.id];
        (q.options || []).forEach(function (opt) {
            var val = typeof opt === 'string' ? opt : opt.value;
            var lbl = typeof opt === 'string' ? opt : opt.label;
            var tip = typeof opt === 'string' ? '' : opt.description;
            var item = document.createElement('label');
            item.className = 'radio-item' + (String(current) === String(val) ? ' selected' : '');
            item.innerHTML = '<input type="radio" name="' + q.id + '" value="' + escapeHtml(val) + '">' +
                '<span class="check-indicator"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"/></svg></span>' +
                '<span class="check-label">' + escapeHtml(lbl) + (tip ? '<span class="opt-desc">' + escapeHtml(tip) + '</span>' : '') + '</span>';
            var inp = item.querySelector('input');
            inp.checked = String(current) === String(val);
            item.addEventListener('click', function (e) {
                e.preventDefault();
                $$('.radio-item', group).forEach(function (ri) { ri.classList.remove('selected'); ri.querySelector('input').checked = false; });
                item.classList.add('selected');
                inp.checked = true;
                setAnswer(q, val);
            });
            group.appendChild(item);
        });
        if (q.options && q.options.length === 1) {
            var none = document.createElement('label');
            none.className = 'text-sm text-muted';
            none.textContent = '(no options generated — skip or leave as-is)';
            group.appendChild(none);
        }
        return group;
    }

    function renderBoolean(q) {
        var group = document.createElement('div');
        group.className = 'radio-group';
        var current = state.answers[q.id];
        [
            { label: 'Yes', value: true },
            { label: 'No', value: false }
        ].forEach(function (opt) {
            var item = document.createElement('label');
            item.className = 'radio-item' + (current === opt.value ? ' selected' : '');
            item.innerHTML = '<input type="radio" name="' + q.id + '" value="' + opt.value + '">' +
                '<span class="check-indicator"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"/></svg></span>' +
                '<span class="check-label">' + opt.label + '</span>';
            var inp = item.querySelector('input');
            inp.checked = current === opt.value;
            item.addEventListener('click', function (e) {
                e.preventDefault();
                $$('.radio-item', group).forEach(function (ri) { ri.classList.remove('selected'); ri.querySelector('input').checked = false; });
                item.classList.add('selected');
                inp.checked = true;
                setAnswer(q, opt.value);
            });
            group.appendChild(item);
        });
        return group;
    }

    function renderMulti(q) {
        var wrap = document.createElement('div');
        wrap.className = 'multi-select';
        var selected = Array.isArray(state.answers[q.id]) ? state.answers[q.id] : [];
        (q.options || []).forEach(function (opt) {
            var val = typeof opt === 'string' ? opt : opt.value;
            var lbl = typeof opt === 'string' ? opt : opt.label;
            var tip = typeof opt === 'string' ? '' : opt.description;
            var chip = document.createElement('span');
            chip.className = 'chip' + (selected.indexOf(val) !== -1 ? ' selected' : '');
            chip.innerHTML = escapeHtml(lbl) + (tip ? '<span class="opt-desc">' + escapeHtml(tip) + '</span>' : '');
            chip.addEventListener('click', function () {
                chip.classList.toggle('selected');
                var arr = (Array.isArray(state.answers[q.id]) ? state.answers[q.id].slice() : []);
                if (chip.classList.contains('selected')) { if (arr.indexOf(val) === -1) arr.push(val); }
                else arr = arr.filter(function (v) { return v !== val; });
                setAnswer(q, arr);
            });
            wrap.appendChild(chip);
        });
        return wrap;
    }

    function renderText(q) {
        var inp = document.createElement('input');
        inp.type = 'text';
        inp.className = 'form-input';
        inp.id = 'q-' + q.id;
        inp.placeholder = q.placeholder || '';
        if (state.answers[q.id] !== undefined) inp.value = state.answers[q.id];
        var timer = null;
        inp.addEventListener('input', function () {
            clearTimeout(timer);
            timer = setTimeout(function () { setAnswer(q, inp.value, { live: true }); }, 200);
        });
        return inp;
    }

    function renderNumber(q) {
        var inp = document.createElement('input');
        inp.type = 'number';
        inp.className = 'form-input';
        inp.id = 'q-' + q.id;
        inp.placeholder = q.placeholder || '';
        if (state.answers[q.id] !== undefined) inp.value = state.answers[q.id];
        var timer = null;
        inp.addEventListener('input', function () {
            clearTimeout(timer);
            timer = setTimeout(function () {
                var n = inp.value === '' ? undefined : Number(inp.value);
                setAnswer(q, n, { live: true });
            }, 200);
        });
        return inp;
    }

    function setAnswer(q, val, opts) {
        opts = opts || {};
        if (val === undefined) delete state.answers[q.id];
        else state.answers[q.id] = val;
        saveProgress();
        pruneHiddenAnswers();
        updateProgress();
        clearQuestionError(q.id);
        if (!opts.live) updatePreview();
        else debouncedPreview();
    }

    function clearQuestionError(qid) {
        var card = document.querySelector('[data-question-id="' + qid + '"]');
        if (card) card.classList.remove('has-error');
    }
    function validateCurrentStep() {
        var qs = getQuestionsForStep(state.currentStep).filter(visibleIfMet);
        var valid = true;
        qs.forEach(function (q) {
            if (!q.required) return;
            var val = state.answers[q.id];
            var isEmpty = val === undefined || val === null || val === '' || (Array.isArray(val) && val.length === 0);
            var card = document.querySelector('[data-question-id="' + q.id + '"]');
            if (isEmpty) { valid = false; if (card) card.classList.add('has-error'); }
            else if (card) card.classList.remove('has-error');
        });
        if (!valid) toast('Please fill in all required fields.', 'warning');
        return valid;
    }

    function goToStep(idx) {
        if (idx < 0 || idx >= STEPS.length) return;
        state.currentStep = idx;
        saveProgress();
        renderSidebar();
        renderWizardStep(idx);
        updateButtons();
        updateStepIndicator();
        updateProgress();
        updatePreview();
        $('#main-scroll').scrollTop = 0;
    }

    /* ── Review + Export steps ───────────────────────────────────────────── */
    function renderReviewStep() {
        var card = document.createElement('div');
        card.className = 'question-card';
        card.innerHTML = '<div class="question-label"><span>Review Your Answers</span></div>' +
            '<div class="question-description">Please review all your selections before generating the license.</div>' +
            '<div id="review-summary" class="mt-2"></div>';
        setTimeout(populateReview, 0);
        return card;
    }
    function populateReview() {
        var container = $('#review-summary');
        if (!container) return;
        var answered = {};
        Object.keys(state.answers).forEach(function (k) {
            var v = state.answers[k];
            if (v !== undefined && v !== null && v !== '' && !(Array.isArray(v) && v.length === 0)) answered[k] = v;
        });
        var ids = Object.keys(answered);
        var html = '<table class="data-table"><thead><tr><th>Question</th><th>Value</th></tr></thead><tbody>';
        ids.forEach(function (id) {
            var q = state.questions.find(function (x) { return x.id === id; });
            var val = answered[id];
            if (Array.isArray(val)) val = val.length ? val.join(', ') : 'None';
            else if (typeof val === 'boolean') val = val ? 'Yes' : 'No';
            else val = String(val);
            html += '<tr><td>' + escapeHtml(q ? q.title : id) + '</td><td>' + escapeHtml(val) + '</td></tr>';
        });
        html += '</tbody></table>';
        container.innerHTML = ids.length ? html : '<p class="text-muted">No answers recorded yet.</p>';
    }

    function renderExportStep() {
        var card = document.createElement('div');
        card.className = 'question-card';
        var html = '<div class="question-label"><span>Export Your License</span></div>' +
            '<div class="question-description">Your license has been generated. Choose an export format below.</div>' +
            '<div class="mt-2 export-grid">';
        [
            ['text', 'Plain Text (.txt)'], ['markdown', 'Markdown (.md)'],
            ['html', 'HTML (.html)'], ['json', 'JSON (.json)'],
            ['yaml', 'YAML (.yaml)'], ['toml', 'TOML (.toml)'],
            ['spdx', 'SPDX Header (.txt)'], ['notice', 'NOTICE'],
            ['copying', 'COPYING']/*, ['summary','Summary'], ['ai_summary','AI Summary']*/
        ].forEach(function (f) {
            html += '<button class="btn btn-secondary export-btn" data-format="' + f[0] + '">' + f[1] + '</button>';
        });
        html += '</div>';
        card.innerHTML = html;
        $$('.export-btn', card).forEach(function (btn) {
            btn.addEventListener('click', function () { exportLicense(btn.getAttribute('data-format')); });
        });
        return card;
    }

    /* ── Compile / validate / explain / export ───────────────────────────── */
    function baseAnswers() {
        var b = {};
        ['project_name', 'copyright_holder', 'copyright_email', 'copyright_org'].forEach(function (k) {
            if (state.answers[k]) b[k] = state.answers[k];
        });
        if (state.answers.year) b.year = Number(state.answers.year);
        return b;
    }

    function tryCompile() {
        if (!ENGINE || !MAP) return { license: null };
        if (!state.answers.license_type) return { license: null };
        try {
            var request = MAP.buildRequest(state.answers, baseAnswers());
            var raw = ENGINE.Compiler.compile(request);
            return raw && raw.license ? raw : { license: raw };
        } catch (e) {
            return { error: e };
        }
    }

    var _debounce = null;
    function debouncedPreview() {
        clearTimeout(_debounce);
        _debounce = setTimeout(updatePreview, 350);
    }

    function updatePreview() {
        var content = $('#preview-content');
        if (!content) return;
        if (state.licenseText) {
            content.innerHTML = '<div class="license-text">' + escapeHtml(state.licenseText) + '</div>';
            return;
        }
        var res = tryCompile();
        if (res && res.license) {
            var lic = res.license;
            var n = lic.clauses ? lic.clauses.length : 0;
            var head = '// compiled locally, ' + n + ' clauses' + (lic.metadata && lic.metadata.spdx_id ? ', spdx: ' + lic.metadata.spdx_id : '') + '\n\n';
            content.innerHTML = '<div class="license-text preview-live">' + escapeHtml(head + (lic.full_text || '')) + '</div>';
            return;
        }
        var hasAny = Object.keys(state.answers).some(function (k) {
            var v = state.answers[k];
            return v !== undefined && v !== null && v !== '' && !(Array.isArray(v) && v.length === 0);
        });
        if (!hasAny || !state.answers.license_type) {
            content.innerHTML = '<div class="preview-placeholder">' +
                '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>' +
                '<p>Choose a base license model to see a live preview.</p></div>';
        } else {
            content.innerHTML = '<div class="preview-placeholder"><p class="text-muted">Live compile is pending your base license choice…</p></div>';
        }
    }

    function generateLicense() {
        if (state.generating) return;
        state.generating = true;
        var genBtn = $('#btn-generate');
        genBtn.disabled = true;
        genBtn.innerHTML = '<span class="loading-spinner"></span> Generating...';
        setTimeout(function () {
            var res = tryCompile();
            if (res && res.license) {
                state.licenseObj = res.license;
                state.licenseText = res.license.full_text || '';
                updatePreview();
                toast('License generated successfully! ' + (res.license.metadata && res.license.metadata.spdx_id ? '(SPDX: ' + res.license.metadata.spdx_id + ')' : ''), 'success');
                $('#btn-export').disabled = false;
            } else {
                var msg = 'Generation failed.';
                if (res && res.error) msg += ' ' + (res.error.message || String(res.error));
                toast(msg, 'error');
            }
            state.generating = false;
            genBtn.disabled = false;
            genBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg> Generate License';
        }, 300);
    }

    function validateLicense() {
        if (!state.licenseText) { toast('No license to validate. Generate one first.', 'warning'); return; }
        if (!ENGINE) { toast('Engine unavailable.', 'error'); return; }
        var vr = ENGINE.Validate.validateText(state.licenseText);
        var issues = [];
        if (vr && vr.errors) vr.errors.forEach(function (e) { issues.push(e.message || e.code || JSON.stringify(e)); });
        var warnings = vr && vr.warnings ? vr.warnings.length : 0;
        if (vr && vr.is_valid) {
            toast('License validation passed! Score: ' + (vr.score != null ? vr.score : 'N/A'), 'success');
        } else {
            toast('Validation: score ' + (vr.score != null ? vr.score : 'N/A') + ', issues: ' + (issues.length ? issues.slice(0, 3).join('; ') : 'unknown'), 'warning');
        }
        showModal('Validation Report',
            '<div style="line-height:1.7;"><p><strong>Status:</strong> ' + ('<span class="badge ' + (vr && vr.is_valid ? 'badge-success' : 'badge-danger') + '">' + (vr && vr.is_valid ? 'Valid' : 'Issues found') + '</span>') +
            ' <strong>Score:</strong> ' + (vr && vr.score != null ? vr.score : 'N/A') + '</p>' +
            '<p><strong>Errors:</strong> ' + (issues.length ? '<ul>' + issues.map(function (i) { return '<li>' + escapeHtml(i) + '</li>'; }).join('') + '</ul>' : '<span class="text-muted">none</span>') + '</p>' +
            '<p><strong>Warnings:</strong> ' + (warnings ? warnings : 0) + '</p></div>',
            [{ label: 'Close', cls: 'btn-primary' }]
        );
    }

    function explainLicense() {
        if (!state.licenseText) { toast('No license to explain. Generate one first.', 'warning'); return; }
        if (!ENGINE) { toast('Engine unavailable.', 'error'); return; }
        var text = '';
        try {
            if (state.licenseObj && ENGINE.Export.exportAiSummary) {
                text = ENGINE.Export.exportAiSummary(state.licenseObj);
            } else if (ENGINE.Export.generateAll && state.licenseObj) {
                text = ENGINE.Export.generateAll(state.licenseObj).ai_summary;
            }
        } catch (e) { text = ''; }
        if (!text) text = explainLocal(state.licenseText);
        showModal('License Explanation',
            '<div style="white-space:pre-wrap;line-height:1.7;">' + escapeHtml(text) + '</div>',
            [{ label: 'Close', cls: 'btn-primary' }]
        );
    }

    function explainLocal(text) {
        var lines = text.split('\n').filter(function (l) { return l.trim().length > 0; });
        var e = 'License Analysis (local)\n\n';
        e += 'This license contains ' + lines.length + ' lines of text.\n\n';
        if (text.indexOf('COMMERCIAL') !== -1) e += '- Contains commercial use terms\n';
        if (text.indexOf('PATENT') !== -1) e += '- Contains patent grant provisions\n';
        if (text.indexOf('SOURCE') !== -1) e += '- Specifies source code disclosure\n';
        if (text.indexOf('MODIFICATION') !== -1) e += '- Addresses modification rights\n';
        if (text.indexOf('AI') !== -1 || text.indexOf('TRAIN') !== -1) e += '- Includes AI/data usage provisions\n';
        if (text.indexOf('WARRANTY') !== -1 || text.indexOf('DISCLAIM') !== -1) e += '- Includes warranty disclaimer\n';
        if (text.indexOf('LIABILITY') !== -1) e += '- Specifies liability limitations\n';
        if (text.indexOf('GOVERNING LAW') !== -1) e += '- Defines governing law\n';
        e += '\nGenerated entirely client-side. No data leaves your browser.';
        return e;
    }

    function exportLicense(format) {
        if (!state.licenseText) { toast('No license to export.', 'warning'); return; }
        var content, filename, mime;
        if (ENGINE && ENGINE.Export && state.licenseObj) {
            try {
                var all = ENGINE.Export.generateAll(state.licenseObj);
                var map = {
                    text: ['plain_text', 'LICENSE.txt', 'text/plain'],
                    markdown: ['markdown', 'LICENSE.md', 'text/markdown'],
                    html: ['html', 'license.html', 'text/html'],
                    json: ['json', 'license.json', 'application/json'],
                    yaml: ['yaml', 'license.yaml', 'text/yaml'],
                    toml: ['toml', 'license.toml', 'application/toml'],
                    spdx: ['spdx', 'SPDX-LICENSE.txt', 'text/plain'],
                    notice: ['notice', 'NOTICE', 'text/plain'],
                    copying: ['copying', 'COPYING', 'text/plain']
                };
                if (map[format]) {
                    content = all[map[format][0]];
                    filename = map[format][1];
                    mime = map[format][2];
                }
            } catch (e) { /* fall through */ }
        }
        if (content === undefined) {
            content = state.licenseText;
            filename = filename || 'LICENSE.txt';
            mime = 'text/plain';
        }
        var blob = new Blob([content], { type: mime });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        toast('Exported as ' + filename, 'success');
    }

    /* ── Search ──────────────────────────────────────────────────────────── */
    function searchLocal(query) {
        var results = $('#search-results');
        if (!state.questions.length) {
            results.innerHTML = '<div class="search-no-results">No data loaded yet.</div>';
            results.classList.remove('hidden');
            return;
        }
        var matches = state.questions.filter(function (q) {
            return (q.title && q.title.toLowerCase().indexOf(query) !== -1) ||
                   (q.description && q.description.toLowerCase().indexOf(query) !== -1) ||
                   (q.category && q.category.toLowerCase().indexOf(query) !== -1) ||
                   q.id.toLowerCase().indexOf(query) !== -1;
        });
        if (matches.length === 0) {
            results.innerHTML = '<div class="search-no-results">No results found.</div>';
        } else {
            results.innerHTML = '';
            matches.forEach(function (q) {
                var step = STEPS.find(function (s) { return s.id === q.step; });
                var div = document.createElement('div');
                div.className = 'search-result-item';
                div.innerHTML = '<div class="sr-label">' + escapeHtml(q.title) + '</div>' +
                    '<div class="sr-step">' + escapeHtml(step ? step.label : q.step) + ' · ' + escapeHtml(q.id) + '</div>';
                div.addEventListener('click', function () {
                    var idx = STEPS.findIndex(function (s) { return s.id === q.step; });
                    if (idx !== -1) {
                        goToStep(idx);
                        setTimeout(function () {
                            var card = document.querySelector('[data-question-id="' + q.id + '"]');
                            if (card) {
                                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                card.style.boxShadow = '0 0 0 2px var(--accent)';
                                setTimeout(function () { card.style.boxShadow = ''; }, 2000);
                            }
                        }, 100);
                    }
                    results.classList.add('hidden');
                    $('#search-input').value = '';
                });
                results.appendChild(div);
            });
        }
        results.classList.remove('hidden');
    }

    function setupSearch() {
        var input = $('#search-input');
        var results = $('#search-results');
        var debounceTimer = null;
        input.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            var query = input.value.trim().toLowerCase();
            if (query.length < 2) { results.classList.add('hidden'); return; }
            debounceTimer = setTimeout(function () { searchLocal(query); }, 250);
        });
        input.addEventListener('focus', function () {
            if (input.value.trim().length >= 2) results.classList.remove('hidden');
        });
        document.addEventListener('click', function (e) {
            if (!e.target.closest('.search-container')) results.classList.add('hidden');
        });
    }

    function setupTheme() {
        var toggle = $('#theme-toggle');
        var stored = null;
        try { stored = localStorage.getItem('glg_theme'); } catch (e) {}
        if (stored) document.documentElement.setAttribute('data-theme', stored);
        toggle.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-theme');
            var next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            try { localStorage.setItem('glg_theme', next); } catch (e) {}
        });
    }

    function setupKeyboard() {
        document.addEventListener('keydown', function (e) {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') {
                if (e.key === 'Escape') e.target.blur();
                return;
            }
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); $('#search-input').focus(); return; }
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); if (state.currentStep < STEPS.length - 1) goToStep(state.currentStep + 1); }
            if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); if (state.currentStep > 0) goToStep(state.currentStep - 1); }
            if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
                e.preventDefault();
                if (state.currentStep === STEPS.length - 1) generateLicense();
                else if (state.currentStep < STEPS.length - 1) goToStep(state.currentStep + 1);
            }
        });
    }

    function setupModal() {
        $('#modal-close').addEventListener('click', hideModal);
        $('#modal-overlay').addEventListener('click', function (e) {
            if (e.target === $('#modal-overlay')) hideModal();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !$('#modal-overlay').classList.contains('hidden')) hideModal();
        });
    }

    function setupMobileSidebar() {
        var backdrop = document.createElement('div');
        backdrop.className = 'sidebar-backdrop';
        document.body.appendChild(backdrop);
        $('#sidebar-toggle').addEventListener('click', function () {
            $('#sidebar').classList.toggle('mobile-open');
            backdrop.classList.toggle('visible');
        });
        backdrop.addEventListener('click', function () {
            $('#sidebar').classList.remove('mobile-open');
            backdrop.classList.remove('visible');
        });
        var previewPanel = $('#preview-panel');
        if (previewPanel) {
            $('#btn-toggle-preview').addEventListener('click', function () {
                previewPanel.classList.toggle('collapsed');
                previewPanel.classList.toggle('mobile-open');
            });
        }
    }

    function setupEventListeners() {
        $('#btn-next').addEventListener('click', function () {
            if (!validateCurrentStep()) return;
            if (state.currentStep < STEPS.length - 1) goToStep(state.currentStep + 1);
        });
        $('#btn-prev').addEventListener('click', function () {
            if (state.currentStep > 0) goToStep(state.currentStep - 1);
        });
        $('#btn-generate').addEventListener('click', generateLicense);
        $('#btn-validate').addEventListener('click', validateLicense);
        $('#btn-explain').addEventListener('click', explainLicense);
        $('#btn-copy').addEventListener('click', function () {
            var text = state.licenseText || '';
            if (!text) { toast('Nothing to copy.', 'warning'); return; }
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(function () { toast('Copied to clipboard!', 'success'); })
                    .catch(function () { fallbackCopy(text); });
            } else fallbackCopy(text);
        });
        $('#btn-reset').addEventListener('click', function () {
            showModal('Reset All Answers', '<p>Are you sure you want to reset all your answers? This cannot be undone.</p>', [
                { label: 'Cancel', cls: 'btn-secondary' },
                { label: 'Reset', cls: 'btn-danger', action: function () {
                    state.answers = {};
                    state.licenseText = '';
                    state.licenseObj = null;
                    state.currentStep = 0;
                    saveProgress();
                    try { localStorage.removeItem('glg_state'); } catch (e) {}
                    renderSidebar();
                    renderWizardStep(0);
                    updateButtons();
                    updateStepIndicator();
                    updateProgress();
                    updatePreview();
                    toast('All answers have been reset.', 'info');
                } }
            ]);
        });
        $('#btn-export').addEventListener('click', function () { exportLicense('text'); });
    }

    function fallbackCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); toast('Copied to clipboard!', 'success'); }
        catch (e) { toast('Failed to copy.', 'error'); }
        document.body.removeChild(ta);
    }

    function init() {
        loadProgress();
        setupTheme();
        setupEventListeners();
        setupSearch();
        setupModal();
        setupKeyboard();
        setupMobileSidebar();
        state.questions = buildQuestions();
        renderSidebar();
        renderWizardStep(state.currentStep);
        updateButtons();
        updateStepIndicator();
        updateProgress();
        updatePreview();
    }

    GLG.version = '1.0.0';
    GLG.state = state;
    GLG.STEPS = STEPS;
    GLG.exportLicense = exportLicense;
    window.GLG = GLG;
    window.__glgExport = exportLicense;

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
})();